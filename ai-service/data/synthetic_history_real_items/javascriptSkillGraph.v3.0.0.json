{
  "version": "3.0.0",
  "domain": {
    "id": "JAVASCRIPT",
    "name": "Lập trình JavaScript Toàn diện, ES6+ & Hướng đối tượng (Modern JavaScript)",
    "description": "Đồ thị tri thức chuẩn hóa 23 kỹ năng nguyên tử (Atomic Skills) với 30 liên kết tiên quyết (DAG), hỗ trợ chẩn đoán đa kỹ năng và định tuyến học tập thích ứng."
  },
  "tiers": [
    {
      "tier": 1,
      "name": "Root & Fundamental",
      "description": "Khai báo biến, kiểu dữ liệu nguyên thủy và runtime I/O."
    },
    {
      "tier": 2,
      "name": "Core Programming",
      "description": "Ép kiểu, điều kiện, vòng lặp, hàm, mảng, chuỗi và đối tượng."
    },
    {
      "tier": 3,
      "name": "Composition & Modern JS",
      "description": "Higher-Order Functions, Destructuring, Spread/Rest và Collection Set/Map."
    },
    {
      "tier": 4,
      "name": "Runtime & Execution Model",
      "description": "Scope, Execution Context, Hoisting, Closure, this và Prototype Chain."
    },
    {
      "tier": 5,
      "name": "Engineering & Architecture",
      "description": "Lập trình hướng đối tượng ES6 Classes, Xử lý lỗi và Module hóa."
