{
  "skills": [
    {
      "id": "KC_VAR",
      "name": "Variables and Basic Math",
      "description": "Khai báo biến, các phép toán số học, kiểu dữ liệu nguyên thủy (int, float, bool) và xuất nhập dữ liệu cơ bản (print, input, type casting)."
    },
    {
      "id": "KC_COND",
      "name": "Conditional Control Flow",
      "description": "Cấu trúc điều kiện rẽ nhánh (if, elif, else), toán tử so sánh diễn giải, và liên kết logic Boolean (and, or, not)."
    },
    {
      "id": "KC_LOOP",
      "name": "Loops and Iteration",
      "description": "Cấu trúc lặp tuần hoàn (for, while), hàm sinh dãy số range(), và cơ chế điều khiển bước nhảy (break, continue)."
    },
    {
      "id": "KC_LIST",
      "name": "Lists and Strings (Strings/Arrays)",
      "description": "Thao tác mảng/chuỗi: truy cập index, cắt mảng (slicing), duyệt danh sách, và các phương thức xử lý chuỗi/list cơ bản."
    },
    {
      "id": "KC_DICT",
      "name": "Dictionaries and Sets",
      "description": "Cấu trúc dữ liệu dạng Key-Value (Chỉ mục kết hợp) và tập hợp duy nhất (Set). Quản lý dữ liệu nhanh chóng và tối ưu hóa thời gian tìm kiếm."
    },
    {
      "id": "KC_FUNC",
      "name": "Functions and Modular Programming",
      "description": "Định nghĩa hàm (def, return), truyền đối số, phạm vị hoạt động của biến (local/global) và tổ chức code module hóa."
    },
    {
      "id": "KC_OOP",
      "name": "Object-Oriented Programming (OOP)",
      "description": "Lập trình hướng đối tượng cơ bản trong Python: định nghĩa class, phương thức khởi tạo __init__, thuộc tính của đối tượng và kế thừa."
    }
  ],
