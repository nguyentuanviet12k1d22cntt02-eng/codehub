server {
    listen 80;
    server_name ${GRADER_PUBLIC_HOST};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 308 https://${GRADER_PUBLIC_HOST}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${GRADER_PUBLIC_HOST};

    ssl_certificate /etc/letsencrypt/live/${GRADER_PUBLIC_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${GRADER_PUBLIC_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 4m;

    location / {
        proxy_pass http://grader-api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 100s;
        proxy_send_timeout 15s;
    }
}
