# Generate a random value of at least 32 characters. Never commit the real token.
GRADER_API_TOKEN=replace-with-a-random-48-character-token

# t3.micro has only 1 GiB RAM. Keep this at 1 until the instance is resized.
GRADER_MAX_CONCURRENCY=1
GRADER_MAX_QUEUE=8
GRADER_QUEUE_TIMEOUT_SECONDS=30
GRADER_OUTPUT_LIMIT_BYTES=131072

GRADER_PYTHON_IMAGE=learnpython-grader-python:3.11
GRADER_JAVASCRIPT_IMAGE=learnpython-grader-node:20
GRADER_C_IMAGE=learnpython-grader-gcc:14
GRADER_CPP_IMAGE=learnpython-grader-gcc:14
GRADER_JOBS_DIR=/var/lib/learnpython-grader/jobs

# Public EC2 address used by the TLS reverse proxy.
GRADER_PUBLIC_HOST=47.128.81.75
